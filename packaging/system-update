#!/usr/bin/env bash
set -uo pipefail

exec 1>&2
export HOME="${HOME:-/root}"
export PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/bin:/bin}"

ID="syncthing-monitor"
TITLE="Syncthing Monitor"
SUPPORT="/usr/lib/$ID"
STATE_FILE="${UPDATE_SOURCE_STATE:-/var/lib/$ID/source}"

log() {
    printf '%s: %s\n' "$ID" "$*"
}

if [[ ! -r $SUPPORT/lib.sh ]]; then
    log "$SUPPORT/lib.sh is missing, run ./install.sh again to repair the updater"
    exit 0
fi
source "$SUPPORT/lib.sh"

[[ -r $STATE_FILE ]] || exit 0
state_dir=$(dirname "$STATE_FILE")
failed_file="$state_dir/update-failed"
exec 9>"$state_dir/update.lock"
if ! flock -n 9; then
    log "another update is already running, skipping"
    exit 0
fi
mapfile -t state <"$STATE_FILE"
checkout="${state[0]:-}"
owner="${state[1]:-}"
installer="${state[2]:-}"
[[ -n $checkout && -n $owner ]] || exit 0
uid=$(id -u "$owner" 2>/dev/null) || exit 0
home=$(getent passwd "$owner" | cut -d: -f6)

as_owner() {
    runuser -u "$owner" -- env -i HOME="$home" USER="$owner" LOGNAME="$owner" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15" "$@"
}

git_owner() {
    as_owner git -C "$checkout" "$@"
}

if [[ ! -d $checkout ]]; then
    if [[ -d $home ]]; then
        log "checkout $checkout is gone, removing the system updater"
        remove_system_update_files
    else
        log "checkout $checkout is gone but $home is missing, skipping"
    fi
    exit 0
fi
if ! git_owner rev-parse --git-dir >/dev/null 2>&1; then
    log "checkout $checkout is not a git repository, skipping"
    exit 0
fi
pulled=false
if git_owner rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    if ! git_owner fetch --quiet; then
        log "could not fetch updates for $checkout, checking only the packages it depends on"
    elif [[ $(git_owner rev-list --count 'HEAD..@{upstream}') -gt 0 ]]; then
        if [[ -n $(git_owner status --porcelain --untracked-files=no) ]]; then
            log "$checkout has local changes, skipping the pull"
        elif [[ $(git_owner rev-list --count '@{upstream}..HEAD') -gt 0 ]]; then
            log "$checkout has local commits that aren't upstream, skipping the pull"
        elif git_owner merge --ff-only --quiet '@{upstream}'; then
            git_owner submodule update --init --recursive --quiet
            pulled=true
            log "updated to $(git_owner rev-parse --short HEAD)"
        fi
    fi
fi

manager=$(package_manager) || exit 0
fingerprint=$(dependency_fingerprint "$manager")
if ! $pulled && [[ $(cat "$UPDATE_DEPENDENCIES_FILE" 2>/dev/null) == "$fingerprint" ]]; then
    exit 0
fi

inputs="$(git_owner rev-parse HEAD) $fingerprint"
if [[ $(cat "$failed_file" 2>/dev/null) == "$inputs" ]]; then
    log "last update failed for these inputs, skipping; run ./install.sh to retry"
    exit 0
fi
install -Dm755 "$checkout/packaging/system-update" "$UPDATE_LIB_DIR/system-update"
install_update_hook "$checkout" "$manager"
if [[ -z $installer || ! -x $installer/install.sh ]]; then
    log "$installer/install.sh is missing, run ./install.sh again to finish updating $TITLE"
    exit 0
fi
if [[ ! -S /run/user/$uid/bus ]]; then
    as_owner mkdir -p "$home/.local/state/$UPDATE_ID"
    as_owner touch "$home/.local/state/$UPDATE_ID/update-pending"
    log "$TITLE will finish updating at your next login"
    exit 0
fi
if as_owner env SYNCTHING_MONITOR_SOURCE_DIR="$checkout" SYNCTHING_MONITOR_INSTALL_SUPPORT="$installer/packaging" \
    "$installer/install.sh" --system-update; then
    rm -f "$failed_file"
    printf '%s\n' "$fingerprint" >"$UPDATE_DEPENDENCIES_FILE"
else
    printf '%s\n' "$inputs" >"$failed_file"
    log "the update failed, it will not be retried until the source changes"
fi
