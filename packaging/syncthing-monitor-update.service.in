[Unit]
Description=Finish the Syncthing Monitor update from the last system update
ConditionPathExists=%h/.local/state/syncthing-monitor/update-pending
After=graphical-session.target

[Service]
Type=oneshot
WorkingDirectory=@CHECKOUT@
ExecStart=@CHECKOUT@/install.sh --system-update

[Install]
WantedBy=graphical-session.target
