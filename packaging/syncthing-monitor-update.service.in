[Unit]
Description=Finish the Syncthing Monitor update from the last system update
ConditionPathExists=%h/.local/state/syncthing-monitor/update-pending
After=graphical-session.target

[Service]
Type=oneshot
Environment="SYNCTHING_MONITOR_SOURCE_DIR=@CHECKOUT@"
Environment="SYNCTHING_MONITOR_INSTALL_SUPPORT=@INSTALL_SUPPORT@"
ExecStart=@INSTALLER@ --system-update

[Install]
WantedBy=graphical-session.target
